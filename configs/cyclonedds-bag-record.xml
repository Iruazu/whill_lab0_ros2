<?xml version="1.0" encoding="UTF-8"?>
<!--
  CycloneDDS 設定: bag 録画専用 (loopback 限定 + マルチキャスト無効化)

  ⚠ この xml は bag 録画時のみ使用。localization / Nav2 / M6-R 運用には
  `cyclonedds-runtime.xml` を使うこと。

  Why (旧 cyclonedds-lo-only.xml、2026-07-08 M5-R gap 対策 deb317d):
    2026-07-08 campus-outer bag (47 分) の bag time 1325 秒地点で 4.77 秒間の
    IMU/LiDAR 完全停止が発生。原因はテザリング接続中の CycloneDDS が外部ピア
    (10.130.7.163 / 172.20.10.2 等) への UDP 送信を延々リトライしてハング。
    docs/ja/imu-coordinate-audit.md §7.6 参照。

    「録画前に WiFi を OFF する」という運用は 47 分の一発勝負では弱すぎるため
    (人間依存の抜けが致命的)、DDS 側で構造的に外部ピアを見せない設定にする。

  Why (「録画専用」への降格、2026-07-12 M6R-2 live):
    Interfaces=lo + AllowMulticast=false の逆振り構成は SPDP unicast race を
    招き、localizer の subscription match が起動ごとに不安定化する
    (rmw_cyclonedds#376)。運用 (subscription が確実に成立してほしい局面) には
    向かない。ただし bag 録画は「録画中に外部 IP へ UDP を投げない」ことだけ
    保証できれば十分なので、本 xml をそのまま流用する。運用側は
    cyclonedds-runtime.xml (許可列挙方式 + AllowMulticast=spdp) を使う。

  How to use (bag 録画時のみ):
    terminal 単位で切り替え (~/.bashrc は運用 default = runtime.xml のまま):
      export CYCLONEDDS_URI=file:///home/systemlab/whill_lab0_ros2/configs/cyclonedds-bag-record.xml
      ros2 daemon stop && ros2 daemon start
      ros2 bag record /velodyne_points /imu/data_rep145 /whill/odom /tf

  Verify (録画中):
    ros2 topic hz /velodyne_points  → ~10 Hz が安定
    ros2 bag info <bag-dir>          → 全 4 topic の count が想定値
-->
<CycloneDDS xmlns="https://cdds.io/config"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="https://cdds.io/config https://raw.githubusercontent.com/eclipse-cyclonedds/cyclonedds/master/etc/cyclonedds.xsd">
  <Domain id="any">
    <General>
      <!-- loopback だけを DDS 通信に使う。WiFi/Ethernet 経由は完全に無視 -->
      <Interfaces>
        <NetworkInterface name="lo"/>
      </Interfaces>
      <!-- マルチキャスト discovery を停止。lo 上でも UDP unicast のみ -->
      <AllowMulticast>false</AllowMulticast>
      <!-- 外部ピアが仮に見えても接続を試行しない -->
      <DontRoute>true</DontRoute>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <!--
        lo 単一 IF では participant index が枯渇しやすい。CycloneDDS の
        既定 MaxAutoParticipantIndex は 9 で、bringup (whill + ekf +
        imu_sign_corrector + realsense + velodyne 系 + ros2 daemon 等)
        は軽く超えるため、遅く起動したノードから "Failed to find a
        free participant index for domain 0" で落ちる。
        2026-07-10 朝の bringup で 4 ノード死亡 (whill / ekf_node /
        imu_sign_corrector / realsense) を実測。100 に引き上げ。
      -->
      <MaxAutoParticipantIndex>100</MaxAutoParticipantIndex>
      <!-- Peers を空にすることでピア発見を lo unicast のみに閉じる -->
      <Peers>
        <Peer address="localhost"/>
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
