repositories:
  third_party/ros2_whill:
    type: git
    # Iruazu fork. Pinned to an annotated tag rather than the humble branch so
    # vcs import resolves to a fixed commit even if humble itself moves
    # forward later. Bumped when a fork patch lands and is intended for
    # downstream consumption.
    # Diff vs the previous M2 anchor (humble@ceebd45):
    #   - cold-boot init patch (SetPower + SendSetJoystickCommandWithLocal in
    #     WhillNode::Initialize). See docs/m2-whill-core.md.
    #   - /whill/odom publisher (nav_msgs/Odometry) in whill_driver, consumed
    #     by the M4R-3 robot_localization EKF. See Iruazu/whill_lab0_ros2#35.
    url: https://github.com/Iruazu/ros2_whill.git
    version: humble-with-odom-2026-06-18
  third_party/ros2_whill_interfaces:
    type: git
    url: https://github.com/whill-labs/ros2_whill_interfaces.git
    version: humble

  # --- M3 sensor drivers (Group A, official ROS 2 upstreams) ---
  # Velodyne VLP-16, port 2368, 10 Hz (RPM 600), frame_id "velodyne".
  # Defaults inherited from the noetic stack — no IP override (unicast UDP).
  third_party/velodyne:
    type: git
    url: https://github.com/ros-drivers/velodyne.git
    version: 2.5.1
  # Intel RealSense D435 (USB 3, VID:PID 8086:0b07). Requires librealsense2
  # system package before colcon build will succeed; ros-humble-librealsense2
  # from the standard ROS apt repo is sufficient.
  # See docs/m3-sensors.md for the install snippet.
  third_party/realsense-ros:
    type: git
    url: https://github.com/IntelRealSense/realsense-ros.git
    version: 4.55.1
  # RT 9-axis USB IMU. Lab uses /imu/data_raw as FAST-LIO input topic.
  third_party/rt_usb_9axisimu_driver:
    type: git
    url: https://github.com/rt-net/rt_usb_9axisimu_driver.git
    version: humble-devel

  # FAST-LIO (HKU-MaRS, GPL) と、その依存でしか要らなかった livox_ros_driver2 は
  # 2026-07-22 に import 定義ごと撤去した。理由: FAST-LIO はランタイム localizer
  # としては platform-pivot §5 で凍結され、運用は lidar_localization_ros2 (BSD-2,
  # ADR-0006) に置換済み。マップ作成 SLAM も GLIM (MIT, ADR-0003 accepted) を採用し
  # 本番 campus マップは GLIM で生成済み (docs/maps/campus/metadata.yaml)。FAST-LIO
  # 系 (GPL) は現構成のどこからも使われず、GPL をツリーに置く必要がないため除去。

  # --- M6-R runtime localizer ---
  # rsasaki0109/lidar_localization_ros2 (BSD-2). NDT scan-to-map that
  # publishes map -> odom, /pcl_pose, /alignment_status. Consumes the
  # DUFOMap-cleaned static PCD from docs/maps/<site>/. Runs with
  # use_imu: false by default (EKF supplies odom -> base_link separately).
  #
  # Pinned to the commit verified against the M6R-1 smoke test on
  # docs/maps/campus-outdoor-corrected (fitness_score 0.011 vs
  # threshold 6.00, /alignment_status message: ok, map -> odom TF
  # published continuously — PR #74, 2026-07-08). ADR-0006 records this
  # as the accepted version. Bumping this SHA requires re-running
  # scripts/m6r_smoke_test.sh against docs/maps/campus-outdoor-corrected
  # (or the current demo map) and re-confirming the four ADR-0006
  # acceptance criteria before merging.
  third_party/lidar_localization_ros2:
    type: git
    url: https://github.com/rsasaki0109/lidar_localization_ros2.git
    version: 1dbcf3a655328d79a52252d11c8836502011ba5f  # 2026-07-04 G3 refactor
  # Upstream lidar_localization_ros2 lists ndt_omp_ros2 in its own
  # dependencies.repos. Duplicated here so a single `vcs import` from
  # whill_lab.repos is sufficient (avoids requiring the reviewer to run
  # a second vcs import from src/third_party/lidar_localization_ros2/).
  third_party/ndt_omp_ros2:
    type: git
    url: https://github.com/rsasaki0109/ndt_omp_ros2.git
    version: humble

  # --- M6R-4b Ground removal preprocessing ---
  # Patchwork++ (KAIST Urban Robotics Lab, IROS'22). Concentric-zone
  # model with region-wise plane fitting + A-GLE + RNR + TGR. Chosen for
  # the 2D-slice obstacle_layer's structural failure on gradient + local
  # unevenness observed at 工農研横 2026-07-14 Phase B (see
  # docs/decisions/0011-ground-removal-choice.md).
  #
  # License note (important): the repo root LICENSE is BSD-2-Clause
  # (KAIST, 2024) covering the C++ core under cpp/. The ros/ subtree
  # has an internal license contradiction — ros/LICENSE claims MIT
  # (KISS-ICP authors) but ros/package.xml declares GPL-3.0. We take
  # only the BSD-2-Clause cpp/ core and write our own permissive ROS 2
  # wrapper in src/whill_perception/. To keep colcon from building the
  # GPL-declared ros/ package, drop a COLCON_IGNORE after vcs import:
  #
  #   vcs import src < whill_lab.repos
  #   touch src/third_party/patchwork_plusplus/ros/COLCON_IGNORE
  #
  # Bumping this pin requires reconfirming the license story upstream
  # has not degraded further.
  third_party/patchwork_plusplus:
    type: git
    url: https://github.com/url-kaist/patchwork-plusplus.git
    version: v1.4.1
