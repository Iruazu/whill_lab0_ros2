# colcon build outputs
build/
install/
log/

# Upstream packages imported via `vcs import` — pin via whill_lab.repos
src/third_party/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# C++ build artifacts
*.o
*.obj
*.so
*.a

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# rosdep / ament caches
.ament/
.colcon/

# Local env overrides (do not commit secrets)
.env
.env.local

# Backup files generated by editors
*~
*.bak
*.orig

# Captured bench data — rosbag directories are large; keep only descriptive
# artifacts (READMEs, frames.pdf) under docs/m3-bench-data/.
docs/m3-bench-data/*/
!docs/m3-bench-data/*.md
!docs/m3-bench-data/*.pdf

.claude/settings.local.json
# Map artifacts — PCD point clouds are large; track only pgm/yaml/metadata.
docs/m5-maps/*.pcd
docs/maps/**/*.pcd

# tf2_tools view_frames and RViz write diagnostic / session files to the
# repo root as a side effect of normal development (each `ros2 run tf2_tools
# view_frames` adds two more files). Excluding them here, rather than
# relying on a global ignore, keeps the rule visible to every contributor.
# The leading slash pins the pattern to the repo root so package-internal
# rviz configs (e.g. src/whill_navigation/config/*.rviz) are not swept up.
/frames_*.gv
/frames_*.pdf
/*.rviz
