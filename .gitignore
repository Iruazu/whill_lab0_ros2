# colcon build outputs
build/
install/
log/

# Upstream packages imported via `vcs import` — pin via whill_lab.repos
src/third_party/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# C++ build artifacts
*.o
*.obj
*.so
*.a

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# rosdep / ament caches
.ament/
.colcon/

# Local env overrides (do not commit secrets)
.env
.env.local

# Backup files generated by editors
*~
*.bak
*.orig

# Captured bench data — rosbag directories are large; keep only descriptive
# artifacts (READMEs, frames.pdf) under docs/m3-bench-data/.
docs/m3-bench-data/*/
!docs/m3-bench-data/*.md
!docs/m3-bench-data/*.pdf

# Same policy for the M4-R odom-layer bench data captured under
# docs/m4r-bench-data/ (see that directory's README for the protocol).
docs/m4r-bench-data/*/
!docs/m4r-bench-data/*.md
!docs/m4r-bench-data/*.pdf

# docs/m5r-bench-data/ holds the interim artifacts of the M5-R pipeline
# (bag -> SLAM dump -> dynamic-removal dump). All of these are heavy and
# regenerable from the recorded bag + the pinned commit, so git tracks
# only the small descriptive artifacts. Final-deliverable maps land under
# docs/maps/<site>/ (ADR-0005) and have their own rule below.
#
# Patterns are file-glob based (not directory-based) because gitignore
# cannot re-include files inside an ignored directory, and we DO want
# manifest.yaml inside glim-out/ etc. tracked. Convention is finalised
# in docs/m5r-bench-data/README.md.
#
# Ignored:
#   bag/ , bag-imu-fixed/ — rosbag2 directories (hundreds of MB)
#   *.pcd                 — point clouds (tens of MB each)
#   *.bin                 — GLIM compact binaries (points/intensities/
#                           normals/covs_compact.bin per keyframe,
#                           graph.bin, values.bin)
#   *.txt                 — GLIM trajectories (traj_*.txt, odom_*.txt,
#                           graph.txt, per-keyframe data.txt / imu_rate.txt)
#   *.log                 — vram / rss / slam / gtsam_env logs
#
# Tracked (allowlist):
#   *.md            — per-run notes, READMEs
#   manifest.yaml   — ADR-0003 input (small, structured)
#   run.log         — per-run summary that the wrapper tees at the top
docs/m5r-bench-data/**/bag/
docs/m5r-bench-data/**/bag-imu-fixed/
docs/m5r-bench-data/**/*.pcd
docs/m5r-bench-data/**/*.bin
docs/m5r-bench-data/**/*.txt
docs/m5r-bench-data/**/*.log
!docs/m5r-bench-data/**/run.log
!docs/m5r-bench-data/**/manifest.yaml
!docs/m5r-bench-data/**/*.md

# docs/m6r-bench-data/ holds M6-R smoke test / live acceptance / verify
# artifacts. Rosbag directories are multi-GiB; track only descriptive
# artifacts (manifest.yaml, per-run txt/log dumps, READMEs).
# Historical exception: 2026-07-12-acceptance-campus/bag/ was a 24 KiB
# broken bag intentionally committed as "before" evidence for the DDS
# xml fix (already tracked before this rule; gitignore does not affect
# tracked files).
docs/m6r-bench-data/**/bag/
!docs/m6r-bench-data/**/manifest.yaml
!docs/m6r-bench-data/**/*.md

.claude/settings.local.json
# Map artifacts — PCD point clouds are large; track only pgm/yaml/metadata.
# The `docs/maps/<site>/` registry convention is defined in docs/maps/README.md
# (Issue #47 / M5R-5). The recursive `**` pattern covers both new sites and
# `lab-legacy-m5b/` (the renamed `docs/m5-maps/` from before the convention).
docs/maps/**/*.pcd

# tf2_tools view_frames and RViz write diagnostic / session files to the
# repo root as a side effect of normal development (each `ros2 run tf2_tools
# view_frames` adds two more files). Excluding them here, rather than
# relying on a global ignore, keeps the rule visible to every contributor.
# The leading slash pins the pattern to the repo root so package-internal
# rviz configs (e.g. src/whill_navigation/config/*.rviz) are not swept up.
/frames_*.gv
/frames_*.pdf
/*.rviz

# GLIM interactive viewer writes Dear ImGui window layout state
# (imgui.ini) to cwd on exit. When GLIM is launched from the repo root
# this lands in the tree. Ignore at the repo root only; if a package
# needs its own imgui state it is free to track it.
/imgui.ini

# Conversation exports from `/export` slash command land at repo root
# with names like `2026-07-10-142721-dataddsimu.txt`. Plain rosbag info
# dumps that operators save with similar names (`2026-07-09-232918-bag.txt`)
# fall under the same pattern. Neither belongs in the repo — they are
# session-scoped and easy to regenerate.
/2026-*-*.txt
/2027-*-*.txt

# scratchpad/ holds session-scoped investigation tools. Python scripts
# there ARE tracked (e.g. frame_audit.py, imu_live_check.py,
# investigate_thin_corridor.py — the calibration-ledger and audit doc
# reference them by path). Temporary artifacts (PNG screenshots, JSON
# scratch results) are NOT tracked; if a plot needs to persist it should
# live under docs/ instead.
scratchpad/*.png
scratchpad/*.jpg
scratchpad/*.jpeg
scratchpad/*.pdf
scratchpad/*.svg
